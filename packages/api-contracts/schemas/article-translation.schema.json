{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilsp.example/schemas/internal/article-translation.schema.json",
  "title": "ILSP internal article translation record",
  "type": "object",
  "required": [
    "articleId",
    "locale",
    "sourceUpdatedAt",
    "status",
    "coverage",
    "title",
    "dek",
    "category"
  ],
  "properties": {
    "articleId": { "type": "string", "minLength": 1 },
    "locale": { "enum": ["he"] },
    "sourceUpdatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["reviewed-prototype"] },
    "coverage": { "enum": ["summary", "full"] },
    "title": { "type": "string", "minLength": 1 },
    "dek": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "body": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "facts": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "media": {
      "type": "object",
      "required": ["alt", "caption"],
      "properties": {
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "coverage": { "const": "full" } },
        "required": ["coverage"]
      },
      "then": { "required": ["body", "facts", "media"] }
    }
  ],
  "additionalProperties": false
}
