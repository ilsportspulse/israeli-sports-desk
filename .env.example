# Used by the ingestion worker, never exposed to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
NEWSROOM_WEB_VERIFY=true
# Used by the optional standalone scheduler. The Codex automation also runs every 30 minutes.
NEWSROOM_INTERVAL_MINUTES=30
ILSP_LOCAL_SCHEDULER=0
# Used only when a source has no maxPerRun in config/sources.json.
NEWSROOM_MAX_PER_SOURCE=5
# Fresh-news discovery window; archive work uses its own research process.
NEWSROOM_MAX_CANDIDATE_AGE_HOURS=24
NEWSROOM_USER_AGENT=IsraelSportsPulseBot/0.1 (+mailto:editor@example.com)
NEWSROOM_REFRESH_SECRET=replace-with-a-long-random-value
NEWSROOM_AUTO_PUBLISH=false

# Score centre. TheSportsDB supplies verified local schedules and completed tables without a key.
# Public launch still requires confirmation that the chosen feed licence covers editorial display.
SPORTS_DATA_PROVIDER=thesportsdb

# Existing local sportsbook read API (scores and fixtures only).
ELITE_SPORTS_API_URL=http://localhost:4000

# Optional full football feed (scores, fixtures and standings).
SPORTMONKS_API_TOKEN=
SPORTMONKS_ISRAEL_SEASON_ID=
SPORTMONKS_ISRAEL_SEASON_LABEL=2026/27
# Preferred for full football-pyramid coverage. Example:
# SPORTMONKS_ISRAEL_SEASONS=[{"id":"123","name":"Israeli Premier League","label":"2026/27"},{"id":"456","name":"Liga Leumit","label":"2026/27"}]
SPORTMONKS_ISRAEL_SEASONS=
