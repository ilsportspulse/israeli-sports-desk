{
  "name": "israeli-sports-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "next lint",
    "ingest": "node scripts/ingest.mjs",
    "ingest:dry": "node scripts/ingest.mjs --dry-run",
    "scheduler": "node scripts/scheduler.mjs",
    "media:sync": "node scripts/source-commons-media.mjs",
    "media:audit": "node scripts/source-commons-media.mjs --dry-run",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/editorial-audit.mjs && node scripts/style-audit.mjs",
    "style:audit": "node scripts/style-audit.mjs",
    "social:validate": "node scripts/validate-social-launch.mjs",
    "governance:validate": "node scripts/validate-governance-launch.mjs",
    "scores:validate": "node scripts/validate-score-provider-coverage.mjs",
    "contracts:validate": "node scripts/validate-api-contracts.mjs",
    "mobile:validate": "node scripts/validate-mobile-release-plan.mjs",
    "partners:validate": "node scripts/validate-partner-submissions.mjs",
    "partners:intake:validate": "node scripts/validate-partner-intake-monitoring.mjs",
    "partners:brief:validate": "node scripts/validate-partner-brief.mjs",
    "audit:apply": "node scripts/editorial-audit.mjs --apply",
    "cycle:finalize": "node scripts/finalize-cycle.mjs",
    "check": "npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.61.1",
    "typescript": "5.9.3"
  }
}
